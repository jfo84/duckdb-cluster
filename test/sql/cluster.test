# name: test/sql/cluster.test
# description: upgma() clusters by average linkage over a complete set of pairwise distances
# group: [sql]

require cluster

# Two tight pairs whose cross distances are 0.8, 1.0, 0.9 and 0.9 join at their mean, 0.9: single
# linkage would join at 0.8 and complete linkage at 1.0.
statement ok
CREATE TABLE two_pairs AS
SELECT * FROM (VALUES (0, 1, 0.1), (2, 3, 0.2), (0, 2, 0.8), (0, 3, 1.0), (1, 2, 0.9), (1, 3, 0.9)) t(a, b, d);

query IIIRI
SELECT m.k, m.left, m.right, round(m.height, 12), m.size
FROM (SELECT unnest(upgma(a, b, d)) AS m FROM two_pairs)
----
0	0	1	0.1	2
1	2	3	0.2	2
2	4	5	0.9	4

# {0,1,2} meets 3 at (0.9 + 0.9 + 0.3) / 3 = 0.7, each member weighted once; weighting the two clusters
# equally would give 0.6.
query IIIRI
SELECT m.k, m.left, m.right, round(m.height, 12), m.size
FROM (SELECT unnest(upgma(a, b, d)) AS m
      FROM (VALUES (0, 1, 0.1), (0, 2, 0.2), (1, 2, 0.2), (0, 3, 0.9), (1, 3, 0.9), (2, 3, 0.3)) t(a, b, d))
----
0	0	1	0.1	2
1	2	4	0.2	3
2	3	5	0.7	4

# Leaves are numbered by rank of their ids, and a pair may be given in either order.
query IIIRI
SELECT m.k, m.left, m.right, round(m.height, 12), m.size
FROM (SELECT unnest(upgma(a, b, d)) AS m FROM (VALUES (300, 100, 0.5), (200, 100, 0.25), (300, 200, 0.75)) t(a, b, d))
----
0	0	1	0.25	2
1	2	3	0.625	3

# One tree per group.
query II
SELECT g, len(upgma(a, b, d)) FROM (VALUES (1, 0, 1, 0.5), (2, 0, 1, 0.1), (2, 0, 2, 0.4), (2, 1, 2, 0.3)) t(g, a, b, d)
GROUP BY g ORDER BY g
----
1	1
2	2

# No rows is no tree.
query I
SELECT upgma(a, b, d) FROM two_pairs WHERE false
----
NULL

statement error
SELECT upgma(a, b, d) FROM two_pairs WHERE NOT (a = 0 AND b = 3)
----
5 pairs for 4 leaves

statement error
SELECT upgma(a, b, d) FROM (SELECT * FROM two_pairs UNION ALL SELECT 1, 0, 0.1)
----
7 pairs for 4 leaves

statement error
SELECT upgma(a, b, d) FROM (SELECT * FROM two_pairs WHERE NOT (a = 0 AND b = 3) UNION ALL SELECT 1, 0, 0.1)
----
appears twice

statement error
SELECT upgma(a, b, d) FROM (VALUES (0, 1, NULL::DOUBLE)) t(a, b, d)
----
every pair must be measured

statement error
SELECT upgma(a, b, d) FROM (VALUES (0, 1, 'nan'::DOUBLE)) t(a, b, d)
----
is not finite

statement error
SELECT upgma(a, b, d) FROM (VALUES (0, 0, 0.5)) t(a, b, d)
----
joins 0 to itself
